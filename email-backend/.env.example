PORT=5050
NODE_ENV=production
FRONTEND_URLS=https://email.invoicemate.net
# set when frontend and backend are on different subdomains, e.g. .invoicemate.net
COOKIE_DOMAIN=

MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/im-emails

APP_SECRET=            # passphrase of PRIVATE_PEM
PRIVATE_PEM=           # encrypted RSA private key (RS256 session tokens)
PUBLIC_PEM=
SERVICE_JWT_SECRET=    # HS256 secret for the 5 minute login-2FA challenge token

SESSION_HOURS=6
TOTP_ISSUER=InvoiceMate Email Portal
# 64 hex chars. Encrypts 2FA + project secrets. NEVER change after go-live.
DATA_ENCRYPTION_KEY=
